# Скопируйте в .env на сервере. В git файл .env не входит.
POSTGRES_USER=superset
POSTGRES_PASSWORD=change-me
SUPERSET_SECRET_KEY=change-me
SUPERSET_ADMIN_PASSWORD=change-me
SUPERSET_URL=http://127.0.0.1:8088
# Хост Postgres так, как его видит процесс Superset. В этом compose это имя сервиса.
ANALYTICS_DB_HOST=postgres
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=analytics
# Сеть, выбранная в отчёте магазинов сразу после сборки. Для демо-данных оставьте Сеть 002.
SUPERSET_DEFAULT_CHAIN=Сеть 002
# Поставьте 1, если в базе не демо-сети «Сеть 001»…«Сеть 150». Иначе проверка после сборки остановится.
# SUPERSET_SKIP_VERIFY=1
